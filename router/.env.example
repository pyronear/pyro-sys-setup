# Teltonika RUT provisioning — copy to router/.env and fill in.
#
# Wiring: plug your laptop into a LAN port of the router (NOT the WAN port).
# The router is its own DHCP server, so you get an address automatically and
# the router answers on ROUTER_IP. Do not connect the WAN port to your
# internet box for provisioning — SSH is firewalled off on the WAN zone.

# --- Required ---------------------------------------------------------------

# Router LAN address. Factory default for RUT devices is 192.168.1.1.
ROUTER_IP=192.168.1.1

# NOTE: this file is sourced by the shell, so always wrap passwords in SINGLE
# quotes. Unquoted, a '#' in a password starts a comment and silently truncates
# it; inside double quotes, '$', '\' and backticks would still be expanded.
# Single quotes keep the value exactly as typed.

# The password printed on the device label (factory default).
# Used only until ADMIN_PASSWORD has been applied; after the first successful
# run the script logs in with ADMIN_PASSWORD instead.
DEFAULT_ADMIN_PASSWORD='password_written_on_device'

# The password you want the router to end up with.
# RutOS enforces a minimum of 8 characters.
ADMIN_PASSWORD='your_admin_password'

# --- Optional ---------------------------------------------------------------

# SIM PIN. Stored in the router config, so it may be set with no SIM inserted;
# it is then applied automatically once a SIM is present.
#
# WARNING: a wrong PIN is retried on every boot and will PUK-lock the SIM after
# 3 attempts. When no SIM is detected the script stores the PIN but cannot
# verify it, and will say so.
#
# Leave empty if the SIM has no PIN, or if PIN verification is disabled.
SIM_PIN=''

# Cameras that must stay reachable on the LAN but must NOT reach the Internet.
# Leave empty to skip firewall configuration entirely.
#
# Format: plain comma-separated IPv4 addresses. No brackets, no quotes,
# no spaces. Do NOT paste the JSON array from provision_config.json as-is.
#
#   correct    CAMERA_IPS='192.168.1.11,192.168.1.12'
#   wrong      CAMERA_IPS='["192.168.1.11", "192.168.1.12"]'
#
# These are the static IPs handed out by provision_reolink.py — see
# target_ips in provision_config.json at the repository root.
CAMERA_IPS=''

# SSH user. Always root on RutOS; override only if you know why.
ROUTER_USER=root
