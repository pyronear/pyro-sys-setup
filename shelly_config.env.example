# Site settings for the Shelly scripts (provision_shelly.sh, harden_shelly.sh,
# setup_shelly_watchdog.sh). Copy to shelly_config.env (git-ignored) and edit.

# Site Wi-Fi the Shelly joins (the RUT200 4G router on stations)
WIFI_SSID="site-wifi"
WIFI_PASS="secret"

# Static address of the Shelly on the site network
SHELLY_IP=192.168.1.97
NETMASK=255.255.255.0
# Router address (RUT200 default)
GATEWAY=192.168.1.1
# DNS=192.168.1.1   # defaults to GATEWAY

# Where to reach the fresh Shelly: its access point (default), or its Ethernet
# address / shellypro4pm-<mac>.local when plugged into the router
SETUP_IP=192.168.33.1

# pyro-engine checkout providing watchdog/shelly/device/watchdog.js
PYRO_ENGINE_DIR=../pyro-engine
