# Site settings for the Shelly scripts (provision_shelly.sh, harden_shelly.sh,
# setup_shelly_watchdog.sh). Copy to shelly_config.env (git-ignored) and edit.

# Site Wi-Fi the Shelly joins (the RUT200 4G router on stations). Leave empty
# to read it from the router over SSH (ADMIN_PASSWORD from router/.env).
WIFI_SSID=
WIFI_PASS=

# Static address of the Shelly on the site network
SHELLY_IP=192.168.1.97
NETMASK=255.255.255.0
# Router address (RUT200 default)
GATEWAY=192.168.1.1
# DNS=192.168.1.1   # defaults to GATEWAY

# Where to reach the fresh Shelly. Leave empty to find it: its access point
# (192.168.33.1) is tried, then the router subnet when plugged in by Ethernet.
# Set it (e.g. shellypro4pm-<mac>.local) if several Shellys are on the network.
SETUP_IP=

# pyro-engine checkout providing watchdog/shelly/device/watchdog.js
PYRO_ENGINE_DIR=../pyro-engine
